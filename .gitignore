# Python
__pycache__/
*.pyc
*.pyo

# Virtual environment
.venv/
venv/
env/

# Generated log files — recreated at runtime
logs/

# Generated private keys and AES session key
# Keep keys/ folder tracked (via keys/.gitkeep) but exclude the actual key files.
# Run  python setup_keys.py  on a clean machine to regenerate them.
keys/*.pem
keys/aes.key

# macOS metadata
.DS_Store

# Windows thumbnail cache
Thumbs.db
